# Transcribro — environment variables
# Copy to .env and fill in values as needed.
# Most settings are managed via electron-store (persisted in userData).

# --- Development overrides ---
# VITE_DEV_SERVER_URL is set automatically by vite-plugin-electron in dev mode.

# --- Optional: default model & language (can also be set in-app) ---
# DEFAULT_MODEL=large-v3
# DEFAULT_LANGUAGE=es
# WHISPER_THREADS=8
