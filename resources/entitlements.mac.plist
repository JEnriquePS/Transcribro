<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow unsigned executable memory — required for whisper-cli (Metal/GGML) -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow JIT — required for Electron's V8 engine -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Disable library validation — required for better-sqlite3 native module -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Inherit entitlements to child processes (whisper-cli, ffmpeg) -->
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
